            "value" : "休日の午前"
          }
        }
      }
    },
    "Weekend afternoon. Nearby usage rises with video streaming and the like." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休日の昼。動画視聴などで近隣の利用が増える時間帯です。"
          }
        }
      }
    },
    "Weekend morning. More people are home, so networks start getting busier." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休日の午前。家にいる人が多く、やや混み始めます。"
          }
