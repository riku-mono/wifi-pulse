    "Rename networks, or merge networks that were recorded separately" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークの名前を変えたり、分かれて記録されたネットワークをまとめたりします"
          }
        }
      }
    },
    "Reported by the access point itself. Not shown for models that don’t support it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスポイント自身が知らせている値です。対応していない機種では表示されません。"
