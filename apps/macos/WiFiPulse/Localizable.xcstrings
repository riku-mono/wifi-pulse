    },
    "Weekday morning. Remote work adds a little load, but it’s generally quiet." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平日の午前。在宅勤務があると少し混みますが、全体としては空いています。"
