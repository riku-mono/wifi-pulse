    "%@ evening — the busiest time of day (around 8–11 PM). Numbers now show your everyday worst case." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の夜。1日で最も混雑する時間帯（20〜23時前後）です。ここでの数値が「普段の最低ライン」の目安になります。"
          }
        }
      }
    },
    "%@ late night — the quietest time for both nearby networks and your ISP, so numbers tend to look their best." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の深夜。近隣も回線も最も空いている時間帯なので、数値は良く出やすくなります（ベストケース）。"
          }
        }
      }
    },
