    "%@ から" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since %@"
          }
        }
      }
    },
    "%@ に測定 · 応答性（RPM）は「回線が埋まっているときに1分あたり何往復できるか」。Apple の目安は 良い=800以上、普通=300〜800、悪い=300未満。300未満ならバッファブロートを疑い、「負荷試験」で区間を切り分けてください。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measured %@ · Responsiveness (RPM) is how many round trips per minute the connection can make while it is saturated. Apple’s guide: good = 800 or more, fair = 300–800, poor = under 300. Under 300 suggests bufferbloat; use Load Test to find which segment is responsible."
          }
        }
      }
    },
    "%@ ネット%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Internet%2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ネット%2$@"
          }
        }
      }
    },
